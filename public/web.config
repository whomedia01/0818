<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Rule 1: Redirect staging/hosting alias domain whomedia1.iisweb.co.kr to Official Canonical Domain -->
        <rule name="Redirect iisweb to Canonical Domain" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTP_HOST}" pattern="^whomedia1\.iisweb\.co\.kr$" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^.*\.iisweb\.co\.kr$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.whomedia.co.kr/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <!-- Rule 2: Redirect non-www to canonical www domain (if hosted on IIS) -->
        <rule name="Redirect non-www to www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^whomedia\.co\.kr$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://www.whomedia.co.kr/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="X-Robots-Tag" value="all" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
